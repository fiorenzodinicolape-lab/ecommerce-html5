const fs = require('fs');
const path = require('path');
const sqlite3 = require('sqlite3').verbose();

const dataDir = path.join(__dirname, 'data');
const dbPath = path.join(dataDir, 'commerce.db');

if (!fs.existsSync(dataDir)) {
  fs.mkdirSync(dataDir, { recursive: true });
}

const db = new sqlite3.Database(dbPath);

function run(sql, params = []) {
  return new Promise((resolve, reject) => {
    db.run(sql, params, function (err) {
      if (err) return reject(err);
      resolve({ id: this.lastID, changes: this.changes });
    });
  });
}

function get(sql, params = []) {
  return new Promise((resolve, reject) => {
    db.get(sql, params, (err, row) => {
      if (err) return reject(err);
      resolve(row);
    });
  });
}

function all(sql, params = []) {
  return new Promise((resolve, reject) => {
    db.all(sql, params, (err, rows) => {
      if (err) return reject(err);
      resolve(rows);
    });
  });
}

async function initDatabase() {
  await run(`
    CREATE TABLE IF NOT EXISTS products (
      id INTEGER PRIMARY KEY AUTOINCREMENT,
      name TEXT NOT NULL,
      description TEXT NOT NULL,
      price REAL NOT NULL,
      category TEXT NOT NULL,
      image_url TEXT,
      featured INTEGER DEFAULT 0,
      created_at DATETIME DEFAULT CURRENT_TIMESTAMP
    )
  `);

  await run(`
    CREATE TABLE IF NOT EXISTS users (
      id INTEGER PRIMARY KEY AUTOINCREMENT,
      name TEXT NOT NULL,
      email TEXT UNIQUE NOT NULL,
      password_hash TEXT NOT NULL,
      role TEXT DEFAULT 'customer',
      created_at DATETIME DEFAULT CURRENT_TIMESTAMP
    )
  `);

  await run(`
    CREATE TABLE IF NOT EXISTS orders (
      id INTEGER PRIMARY KEY AUTOINCREMENT,
      user_id INTEGER,
      customer_name TEXT,
      customer_email TEXT,
      shipping_method TEXT DEFAULT 'standard',
      subtotal REAL NOT NULL,
      shipping_cost REAL NOT NULL,
      total_amount REAL NOT NULL,
      created_at DATETIME DEFAULT CURRENT_TIMESTAMP
    )
  `);

  await run(`
    CREATE TABLE IF NOT EXISTS order_items (
      id INTEGER PRIMARY KEY AUTOINCREMENT,
      order_id INTEGER NOT NULL,
      product_name TEXT NOT NULL,
      product_price REAL NOT NULL,
      quantity INTEGER NOT NULL DEFAULT 1,
      color TEXT,
      size TEXT,
      FOREIGN KEY(order_id) REFERENCES orders(id)
    )
  `);

  const productCount = await get('SELECT COUNT(*) as count FROM products');

  if (productCount.count === 0) {
    const seedProducts = [
      {
        name: 'Classic Tee',
        description: 'Maglia essenziale in cotone organico, perfetta per ogni outfit casual e contemporaneo.',
        price: 49,
        category: 'Casual',
        image_url: 'https://images.unsplash.com/photo-1529139574466-a303027c1d8b?auto=format&fit=crop&w=900&q=80',
        featured: 1
      },
      {
        name: 'Denim Flex',
        description: 'Jeans slim fit dal taglio moderno, comodi e adatti a look city e daily wear.',
        price: 89,
        category: 'Denim',
        image_url: 'https://images.unsplash.com/photo-1483985988355-763728e1935b?auto=format&fit=crop&w=900&q=80',
        featured: 1
      },
      {
        name: 'Coast Dress',
        description: 'Abito versatile in tessuto leggero, perfetto per occasioni informali e serate leggere.',
        price: 119,
        category: 'Elegant',
        image_url: 'https://images.unsplash.com/photo-1524504388940-b1c1722653e1?auto=format&fit=crop&w=900&q=80',
        featured: 1
      },
      {
        name: 'Metro JKT',
        description: 'Giacca urbana oversized, elegante e super comoda per la vita di tutti i giorni.',
        price: 139,
        category: 'Outerwear',
        image_url: 'https://images.unsplash.com/photo-1515886657613-9f3515b0c78f?auto=format&fit=crop&w=900&q=80',
        featured: 1
      },
      {
        name: 'Nexa Hoodie',
        description: 'Felpa premium con cappuccio e tessuto morbido, ideale per outfit casual e comfort elevato.',
        price: 79,
        category: 'Casual',
        image_url: 'https://images.unsplash.com/photo-1521572267360-ee0c2909d518?auto=format&fit=crop&w=900&q=80',
        featured: 0
      },
      {
        name: 'Oasis Shirt',
        description: 'Camicia slim con qualità premium e linea moderna, perfetta da allungare a ogni look.',
        price: 69,
        category: 'Elegant',
        image_url: 'https://images.unsplash.com/photo-1517841905240-472988babdf9?auto=format&fit=crop&w=900&q=80',
        featured: 0
      },
      {
        name: 'Aster Blazer',
        description: 'Blazer leggero da città con silhouette raffinata e dettagli premium.',
        price: 159,
        category: 'Outerwear',
        image_url: 'https://images.unsplash.com/photo-1524504388940-b1c1722653e1?auto=format&fit=crop&w=900&q=80',
        featured: 1
      },
      {
        name: 'Harbor Polo',
        description: 'Polo casual con taglio elegante e tessuto leggero, perfetto per giorni informali.',
        price: 59,
        category: 'Casual',
        image_url: 'https://images.unsplash.com/photo-1507679799987-c73779587ccf?auto=format&fit=crop&w=900&q=80',
        featured: 0
      }
    ];

    for (const product of seedProducts) {
      await run(
        'INSERT INTO products (name, description, price, category, image_url, featured) VALUES (?, ?, ?, ?, ?, ?)',
        [product.name, product.description, product.price, product.category, product.image_url, product.featured]
      );
    }
  }
}

module.exports = { db, initDatabase, run, get, all, dbPath };
